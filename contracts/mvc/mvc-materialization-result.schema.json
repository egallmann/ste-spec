{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egallmann/ste-spec/contracts/mvc/mvc-materialization-result.schema.json",
  "title": "MVCMaterializationResult (MVC-M, DRAFT)",
  "description": "Draft admitted materialized architectural reality surface. Pre-normative; caller-facing admission is kernel-owned.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mvc_m_id",
    "mvc_d_ref",
    "mvc_s_ref",
    "admitted_context_domain_bundles",
    "provenance",
    "integrity",
    "kernel_admission_summary",
    "inclusion_rationale",
    "exclusion_rationale",
    "freshness",
    "negative_space",
    "mvc_m_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "mvc_m_id": {
      "$ref": "#/$defs/stableId"
    },
    "mvc_d_ref": {
      "$ref": "#/$defs/ref"
    },
    "mvc_s_ref": {
      "$ref": "#/$defs/refWithHash"
    },
    "admitted_context_domain_bundles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/refWithHash"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    },
    "kernel_admission_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admission_ref", "admitted"],
      "properties": {
        "admission_ref": {
          "$ref": "#/$defs/ref"
        },
        "admitted": {
          "type": "boolean"
        }
      }
    },
    "inclusion_rationale": {
      "$ref": "#/$defs/rationaleArray"
    },
    "exclusion_rationale": {
      "$ref": "#/$defs/rationaleArray"
    },
    "freshness": {
      "$ref": "#/$defs/freshness"
    },
    "negative_space": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/negativeSpace"
      }
    },
    "projection_result_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "mvc_m_boundary": {
      "type": "string",
      "enum": ["admitted_materialized_surface_kernel_admission_required"]
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:/-]*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "refWithHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "snapshot_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "source_kind"],
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_kind": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_hash"],
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["current", "stale-unknown", "stale-confirmed"]
        },
        "observed_at": {
          "type": "string"
        }
      }
    },
    "rationaleArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rationale"
      }
    },
    "rationale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "selector_path"],
      "properties": {
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "selector_path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "persona_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "task_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "policy_ref": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "negativeSpace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason"],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
